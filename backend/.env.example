API_TITLE=YumeZone

# CORS: origen de cada panel que llama a la API. Frontend, admin y scan se despliegan
# por separado, asi que deben estar LOS TRES origenes (incluidos los de produccion).
# Sin el origen del panel aqui, el navegador bloquea las peticiones en el deploy.
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000,http://localhost:4400,https://yumezone.page,https://yumezone.vercel.app
# Y al desplegar cada panel, anade su origen real (sin barra final), p.ej.:
#   ,https://admin-tu-proyecto.vercel.app,https://scan-tu-proyecto.vercel.app

# Base de Datos (MySQL / MariaDB / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_aqui
DB_NAME=yumezone
DB_POOL_MIN=5
DB_POOL_MAX=20

# Autenticación JWT (Generar clave aleatoria segura de al menos 64 caracteres)
JWT_SECRET=cambiar_por_un_secreto_seguro_y_largo_en_produccion
JWT_ALGO=HS256
JWT_EXP=10080

# Seguridad de Cookies (true para producción HTTPS, false para desarrollo HTTP)
COOKIE_SECURE=false
